# Jump Height data field — build recipe for the monkeyc/monkeydo CLI.
#
# One source tree for one device family (Instinct 3 Solar) — deliberately
# simple. Per-family source overrides (base.sourcePath = source;source-fenix)
# are a spec §5.1/§9 M5 concern, not now: "Instinct correctness first."
#
# tests/ ships in the SAME sourcePath as source/ on purpose: Toybox.Test
# functions are annotated (:test) and the compiler strips them from a normal
# build automatically (ignored unless run with -t) — see garmin/README.md's
# "test-run command". That means there is exactly one jungle file for both
# the shipping build and the unit-test build; no separate test project.

project.manifest = manifest.xml

base.sourcePath = source;tests
base.resourcePath = resources

# The `bench` / `nowrist` split (added 2026-09-14).
#
# Everything annotated (:bench) is stripped from THIS build; everything
# annotated (:nowrist) is kept. NOT `:release` — that name is reserved by the
# compiler ("will not be included in debug builds", SDK
# doc/docs/Monkey_C/Annotations.html) and using it here broke every non-`-r`
# build while the shipped `-r` build compiled clean.
#
# This split is the whole safety mechanism holding Toybox.Sensor out of the
# shipped data field, and it exists because SDK 9.2.0's reference says every
# instance function of that module "will cause an app crash if called from a
# data field app" (doc/Toybox/Sensor.html, all nine of them). Read
# source/WristProbe.mc's header for the full citation.
#
# bench.jungle is the inverse build, for the Epix dev bench only. It is a
# STANDALONE jungle (`monkeyc -f bench.jungle -d epix2 ...`), not an overlay:
# it needs its own manifest for the Sensor permission, and a second jungle
# may not reset project.manifest. A build made that way must never be
# submitted to the store.
base.excludeAnnotations = bench
