    <string id="SettingPuckName">Puck name</string>
    <string id="SettingVibrateOnJump">Vibrate on jump</string>
    <string id="SettingUnitOverride">Units</string>

    <string id="UnitAuto">Auto (follow watch)</string>
    <string id="UnitFeet">Feet</string>
    <string id="UnitMeters">Meters</string>
</strings>
