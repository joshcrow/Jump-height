<?xml version="1.0"?>
<!--
  Jump Height data field — manifest.

  type="datafield": runs inside the rider's own activity profile (GPS/HR/
  laps stay Garmin's; we only add jumps) — see docs/garmin-datafield.md §5.1
  for why a data field, not a standalone app, is the whole product.

  minSdkVersion 3.1.0 is a floor, not the target: it's the level at which
  Toybox.BluetoothLowEnergy is confirmed usable from a data field (spec §9,
  resolved). The real target is the owner's Instinct 3 Solar at API 5.1;
  everything here is written to also be correct at 3.1 semantics per the
  build task's hard constraint (conservative APIs only, first compile is
  unsupervised).
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application entry="JumpFieldApp" id="873B577243574E27AB454C3FF165E7B4"
                     name="@Strings.AppName" type="datafield" minSdkVersion="3.1.0"
                     launcherIcon="@Drawables.LauncherIcon">
        <!--
          Instinct 3 Solar only for M0-M4 (spec §5.1: "Instinct correctness
          first"); Fenix/Epix/Forerunner families are added at M5 once the
          simulator layout passes on this device. FIRST_COMPILE.md #1
          CONFIRMED (2026-08-04, first real monkeyc run, SDK 9.2.0):
          instinct3solar50mm is NOT a real product id — the compiler rejects
          it ("Invalid device id"), and the SDK's own Devices/ directory has
          no such folder; one id covers both case sizes. launcherIcon:
          FIRST_COMPILE.md #8's "if the compiler demands one" branch is the
          one that happened — same run, "A launcher icon must be specified".
        -->
        <iq:products>
            <iq:product id="instinct3solar45mm"/>
            <!--
              epix2 added 2026-08-10 ahead of the M5 schedule for a plain
              hardware reason: the watch actually on the bench is an Epix
              Gen 2 (GarminDevice.xml: part number 006-B3943-00, "EPIX",
              sw 2609), not the Instinct 3 Solar the spec assumes. A .prg
              is per-device, so the Instinct build cannot sideload here.
              Layout caveat: JumpFieldView's FULL_MIN_H/HALF_MIN_H tiers
              were guessed against Instinct's 176x176 MIP; this is a
              416x416 AMOLED, so the field will render but the tier
              breakpoints are unvalidated on it (README "three things to
              check first" #1 applies again for this device).
            -->
            <iq:product id="epix2"/>
        </iq:products>
        <iq:permissions>
            <!-- BLE central: scan/connect/subscribe to the puck's NUS profile. -->
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <!-- Developer FIT fields written into the saved activity (US4). -->
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
