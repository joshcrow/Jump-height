# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# PlatformIO / firmware build output
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
.vscode/

# Captured session data / logs / diagnostics (user-local)
*.log
data/*.csv
!data/example_session.csv
# Parity fixture, not a capture: the gyro-path golden trace (audit F-16).
# Regenerate with sim/make_spin_trace.py.
!data/spin_railed_gyro.csv
data/sessions/
data/logs/
data/diagnostics/
data/wizard_state.json

# Flasher binaries staged by `./tools/jump web` (built locally or by CI)
web/firmware/

# OS
.DS_Store
Thumbs.db

# Sim experiment raw outputs — regenerated by the seeded sim/experiments/*.py
# scripts; the committed scripts + RESULTS.md are the record (like data/*.csv).
sim/experiments/out/

# Plots
*.png
!docs/**/*.png
# Connect IQ store listing images — generated by garmin/store-assets/
# make_assets.py, committed because they ARE the listing (the store keeps
# no source, and a regenerated image should be a deliberate act).
!garmin/store-assets/*.png

# Connect IQ build output (garmin/README.md §3) — like the firmware
# binaries, built fresh, never committed.
garmin/jumpfield/bin/
garmin/puckglance/bin/
# …except the Connect IQ launcher icons: generated source assets (148-192
# bytes), required by the compiler (FIRST_COMPILE.md findings #2), not
# screenshots. The `*.png` rule above would otherwise swallow them.
!garmin/jumpfield/resources/drawables/launcher_icon.png
!garmin/puckglance/resources/drawables/launcher_icon.png
tools/mtp_send
