def cmd_drop(args) -> int:
    from detector import load_params

    p = load_params(CONFIG_PATH)
    h = args.height_cm / 100.0
    expected = math.sqrt(2.0 * h / p.g)
    min_h_cm = 100.0 * p.g * p.min_airtime_s ** 2 / 2.0
    if args.height_cm < min_h_cm + 10:
        print(f"Drop height {args.height_cm:.0f} cm is too low — anything under "
              f"~{min_h_cm:.0f} cm is ignored by design (min_airtime_s). "
              f"Use ≥ {min_h_cm + 15:.0f} cm (a table or head height works).")
        return 1

    dev, proc = open_device(
        args, "drop",
        ["--height-cm", str(args.height_cm), "--drops", str(args.drops)])
    try:
        print("=== Drop calibration ===")
        print(f"Physics: a drop from {args.height_cm:.0f} cm free-falls for exactly "
              f"{expected:.3f}s.\nWe compare what the device measures against that "
              "to find its timing bias.\n")
        print("⚠️  DROP IT IN ITS CASE, not as a bare board.")
        print("   Safety: a bare LiPo taking repeated impacts can be damaged")
        print("   invisibly and fail later. Not worth it for a calibration.")
        print("   Accuracy: this measures DETECTION LATENCY — how the landing")
        print("   impulse reaches the sensor — so it must be calibrated in the")
        print("   configuration you actually ride, which is sealed in the case.\n")
        print("Setup: hold the device so its BOTTOM is exactly at your measured")
        print(f"height ({args.height_cm:.0f} cm above a cushion/pillow), then let go —")
        print("don't throw it. Keep still for a second before each drop.\n")

        # Real hardware collects untethered (a cable spoils clean releases
        # and yanks itself out); the live flow below stays for --fake.
        if not getattr(args, "fake", False):
            return _drop_untethered(args, dev, p, expected)

        _pause(args, dev, "Shake the device once to wake it.")
        dev.wait_for("STATE", timeout=30, value="recording")

        raws: list[float] = []
        for i in range(1, args.drops + 1):
            _pause(args, dev, f"Drop {i} of {args.drops}.")
            ev = dev.wait_for("JUMP", timeout=90)
            if ev is None:
                print(f"  ⚠️ drop {i}: not detected (too low? bounced oddly?) — skipping")
                continue
            raw = float(ev.get("airtime_raw_s", 0))
            raws.append(raw)
            print(f"  drop {i}: measured {raw:.3f}s (true {expected:.3f}s, "
                  f"error {raw - expected:+.3f}s)")

        return _drop_analyze(raws, expected, args, p, dev)
    finally:
        _close_device(dev, proc)


def _drop_untethered(args, dev: "Device", p, expected: float) -> int:
    """Drop collection for a real board: NO cable during the drops."""
    base_n = len(_stored_rows(dev))
    print("Untethered — the cable can't spoil a release:")
    print("  1. Unplug the USB cable (the battery keeps the board running).")
    print("  2. Give it a wake-up shake.")
    print(f"  3. {args.drops} clean drops from exactly {args.height_cm:.0f} cm:")
    print("     hold dead still a second, let go clean, let it land.")
    print("     Pick it up gently between drops.")
    print("  4. Plug the cable back in and return here.")
    dev2 = _reopen_after_replug(dev)
    if dev2 is None:
        return 1
    try:
        dev2.drain_boot(timeout=3.0)
        new = _stored_rows(dev2)[base_n:]
        raws: list[float] = []
        for r in new:
            if abs(r["raw"] - expected) <= 0.15:
                raws.append(r["raw"])
                print(f"  drop {len(raws)}: measured {r['raw']:.3f}s "
                      f"(true {expected:.3f}s, error {r['raw'] - expected:+.3f}s)")
            else:
                print(f"  (ignoring a {r['raw']:.2f}s flight — not a clean "
                      f"{args.height_cm:.0f} cm drop)")
        if not new:
            print("  No new flights in storage at all.")
            _autopsy_trace(dev2)
        return _drop_analyze(raws, expected, args, p, dev2)
    finally:
        dev2.close()


def _send_set(dev: "Device", key: str, val, timeout: int = 8) -> "tuple[bool, list[str]]":
    """Send `set <key> <val>`; return (accepted, response_lines) — False on
    an ERR reply. dev.command()'s own exceptions (e.g. TimeoutError)
    propagate unchanged, for the caller's own try/except to word."""
    resp = dev.command(f"set {key} {val}", timeout=timeout)
    return not any(ln.startswith("ERR") for ln in resp), resp


def _drop_analyze(raws: list[float], expected: float, args, p,
                  dev: "Device | None" = None) -> int:
    """Turn collected drop airtimes into the calibration verdict + save."""
    if len(raws) < 3:
        print(f"\nOnly {len(raws)} good drops — need at least 3. Re-run, "
              "dropping from a bit higher.")
        return 1

    offset = -statistics.median(r - expected for r in raws)
    spread = statistics.pstdev(raws)
    print(f"\nMeasured timing bias: {-offset * 1000:+.0f} ms "
          f"(spread ±{spread * 1000:.0f} ms over {len(raws)} drops)")
    print(f"Recommended airtime_offset_s = {offset:+.4f}")
    # Honest residual: per-drop height error remaining AFTER the correction
    # (median-centering forces the median residual to zero, so report the
    # per-drop scatter instead; drop height obeys h = g*t^2/2).
    errs_cm = [abs(p.g * ((r + offset) ** 2 - expected ** 2) / 2.0) * 100
               for r in raws]
    print(f"Typical per-drop scatter after correction: "
          f"{statistics.mean(errs_cm):.1f} cm of drop height.")

    if spread > 0.03:
        print("⚠️  spread is high — results may be sloppy. Consider re-running "
              "with more careful, stiller drops.")

    # A --fake rehearsal writing a config is DELIBERATE and tested (DECISIONS
    # #17: the whole calibration experience is rehearsable and regression-
    # tested without hardware) — but only into an isolated config. The CLI
    # tests copy params.json to a tempdir and point JH_CONFIG at it.
    #
    # What must not happen is a rehearsal writing the REPO's params.json, the
    # single source of truth for firmware, simulator and analysis alike. On
    # 2026-08-11 `jump drop --fake --drops 3 --yes` did exactly that, printing
    # "✅ saved" and storing airtime_offset_s=-0.0204 from invented drops. The
    # old guard covered only the interactive prompt, so --yes walked past it,
    # and the result is indistinguishable from a real calibration afterwards.
    #
    # So: fake may write an ISOLATED config, never the default one.
    faking = getattr(args, "fake", False)
    default_config = not os.environ.get("JH_CONFIG")
    if faking and default_config:
        write = False
        print("\n(--fake: refusing to write the repo's config/params.json from "
              "simulated drops — that file drives firmware, sim and analysis "
              "alike. Set JH_CONFIG=<path> to rehearse the save into a scratch "
              "copy, or drop for real without --fake.)")
    else:
        write = args.yes
        if not write and sys.stdin.isatty() and not faking:
            write = input("\nWrite this into config/params.json? [y/N] ").strip().lower() == "y"
    if write:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        cfg["detector"]["airtime_offset_s"] = round(offset, 4)
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        print(f"✅ saved to {CONFIG_PATH}")
        applied = False
        if dev is not None:
            # The firmware stores calibration in NVS — apply it live, no
            # reflash, and it survives future reflashes too. The device
            # answers ERR (not an exception) if it rejects the value, so
            # check the reply — a silent false "applied" here would send a
            # whole water session out under the wrong calibration.
            try:
                applied, resp = _send_set(dev, "airtime_offset_s", round(offset, 4))
                if not applied:
                    for ln in resp:
                        print(f"    {ln}")
            except Exception as e:
                print(f"(couldn't apply live: {e})")
        if applied:
            print("✅ applied to the device over the wire — no reflash needed.")
        elif dev is not None:
            print("❌ the device did NOT accept the calibration. Re-run this "
                  "step, or run\n   ./tools/jump flash  to bake it in, then "
                  "./tools/jump selftest  to verify.")
            return 1
        else:
            print("Run  ./tools/jump flash  to bake it into the device.")
    elif getattr(args, "fake", False):
        # Don't tell a rehearsal to "re-run with --yes" — --yes is exactly what
        # is being ignored here, and pointing at it is how someone concludes
        # the tool is broken (or worse, goes looking for a way around it).
        print("(rehearsal complete — run without --fake, on the real device, "
              "to calibrate for real)")
    else:
        print("(not saved — re-run with --yes to save automatically)")
    return 0


