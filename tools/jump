def _run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=str(REPO), capture_output=True, text=True, **kw)


def cmd_status(args) -> int:
    """Live capability status, MACHINE-CHECKED where possible.

    This command exists because the project kept rediscovering work it had
    already finished. Prose status drifts; artifacts do not. So: ask the
    build what commands it actually contains, ask the test suites whether
    they actually pass, ask a connected board what it actually reports —
    and flag STATUS.md as suspect whenever code changed after it did.

    Nothing here is a claim. Every line is a check with a result.
    """
    import subprocess as sp

    def hdr(t):
        print("\n" + t)
        print("-" * len(t))

    rc_any = 0
    print("=== Jump Height — live status ===")
    print("(machine-checked; anything not checkable is marked UNKNOWN, never assumed)")

    # ---------------------------------------------------------------- build
    hdr("Firmware artifact")
    elf = REPO / "firmware/.pio/build/xiaoblesense_adafruit/firmware.elf"
    if not elf.exists():
        print("  ⚠️  no nRF52 build present — run ./tools/jump flash or pio run")
    else:
        age_s = time.time() - elf.stat().st_mtime
        print(f"  built {age_s/3600:.1f} h ago  ({elf.name})")
        try:
            out = sp.run(["strings", str(elf)], capture_output=True, text=True,
                         timeout=60).stdout
        except Exception:
            out = ""
        line = next((l for l in out.splitlines() if l.startswith("# commands:")), None)
        if line:
            cmds = [c.strip() for c in line.split(":", 1)[1].split("|")]
            print(f"  commands in binary ({len(cmds)}): {' '.join(cmds)}")
        else:
            print("  ⚠️  could not read the command list out of the binary")

    # ---------------------------------------------------------------- tests
    hdr("Test suites")
    if getattr(args, "full", False):
        r = sp.run([sys.executable, str(REPO / "tools/jump"), "simtest"],
                   capture_output=True, text=True)
        ok = "RESULT: PASS" in r.stdout
        print(f"  host + CLI suite: {'PASS ✅' if ok else 'FAIL ❌'}")
        if not ok:
            rc_any = 1
    else:
        print("  host + CLI suite: not run (use --full)")
    mc = _find_monkeyc()
    if mc:
        print(f"  Garmin SDK: found ({Path(mc).parent.parent.name})")
        print("  Garmin unit tests: not run here (needs a simulator session)")
    else:
        print("  Garmin SDK: NOT on PATH — watch tests cannot run")

    # ------------------------------------------------------------- hardware
    hdr("Hardware")
    ports = scan_ports()
    if not ports:
        print("  no board connected (status below is UNKNOWN, not 'fine')")
    for port in ports:
        print(f"  {port}:")
        try:
            dev = Device(port)
            dev.drain_boot(timeout=4.0)
            for line in dev.command("info", timeout=6):
                if line.startswith("INFO") or line.startswith("CAL"):
                    print(f"    {line}")
            rows = []
            for line in dev.command("selftest", timeout=25):
                if line.startswith("SELFTEST ") and " detail=" in line:
                    rows.append(line.split(None, 3))
            for r_ in rows:
                print(f"    {r_[1]:8} {r_[2]}")
            dev.close()
        except Exception as e:  # noqa: BLE001 — a bench tool reports, never raises
            print(f"    ⚠️  {type(e).__name__}: {e}")

    # ------------------------------------------------------ staleness check
    hdr("Documentation freshness")
    status_md = REPO / "docs/STATUS.md"
    if not status_md.exists():
        print("  ⚠️  docs/STATUS.md missing — there is no single source of truth")
        rc_any = 1
    else:
        try:
            newest = sp.run(["git", "log", "-1", "--format=%ct", "--",
                             "firmware", "garmin", "tools", "web"],
                            cwd=str(REPO), capture_output=True, text=True).stdout.strip()
            st = sp.run(["git", "log", "-1", "--format=%ct", "--", "docs/STATUS.md"],
                        cwd=str(REPO), capture_output=True, text=True).stdout.strip()
            # FAIL LOUD, NEVER SILENT-GREEN. Every path that cannot produce
            # both timestamps used to fall into the ✅ branch — an untracked
            # STATUS.md, an empty git log, a non-repo checkout all printed
            # "up to date" with rc=0. A staleness gate that fails green is
            # worse than none: it actively tells you the thing it cannot
            # check is fine. (Review 2026-08-14.)
            if not newest or not st:
                print("  ⚠️  CANNOT VERIFY freshness — git gave no timestamp for "
                      + ("STATUS.md" if not st else "the code tree") + ".")
                print("     Is STATUS.md committed? Treat its states as UNVERIFIED.")
                rc_any = 1
            elif int(newest) > int(st):
                delta = (int(newest) - int(st)) / 3600.0
                print(f"  ⚠️  STATUS.md is {delta:.1f} h OLDER than the newest code change.")
                print("     Treat every state in it as suspect until reconciled.")
                rc_any = 1
            else:
                print("  STATUS.md is at least as new as the newest code change ✅")
        except Exception as e:  # noqa: BLE001
            print(f"  ⚠️  freshness check FAILED ({type(e).__name__}) — treat STATUS.md as unverified")
            rc_any = 1

    print("\nNothing above is a promise. Re-run after any change.")
    return rc_any


def _find_monkeyc():
    """Locate the Connect IQ compiler without requiring it on PATH."""
    from shutil import which
    got = which("monkeyc")
    if got:
        return got
    base = Path.home() / "Library/Application Support/Garmin/ConnectIQ/Sdks"
    if base.exists():
        for sdk in sorted(base.iterdir(), reverse=True):
            cand = sdk / "bin/monkeyc"
            if cand.exists():
                return str(cand)
    return None


def cmd_simtest(args) -> int:
    print("=== Software test suite (no hardware needed) ===\n")
    results: list[tuple[str, bool, str]] = []

    # 1. Synthetic detector tests across noise seeds
    ok = True
    for seed in range(5):
        r = _run([sys.executable, "sim/run.py", "--seed", str(seed)])
        if "RESULT: PASS" not in r.stdout:
            ok = False
    results.append(("detector vs synthetic ground truth (5 seeds)", ok, ""))

    # 2. Generated params header is in sync with config/params.json
    r = _run([sys.executable, "tools/gen_params.py", "--check"])
    results.append(("params.gen.h in sync with config/params.json", r.returncode == 0,
                    "" if r.returncode == 0 else "run ./tools/jump gen"))

    # 3. C++ (firmware) vs Python (sim) detector parity
    gxx = shutil.which("g++") or shutil.which("c++")
    if gxx:
        import tempfile

        with tempfile.TemporaryDirectory() as td:
            binp = os.path.join(td, "host_test")
            r = _run([gxx, "-std=c++14", "-Wall", "-Wextra", "-I", "firmware/include",
                      "firmware/test/host_test.cpp", "-o", binp])
            if r.returncode != 0:
                results.append(("C++ firmware detector compiles", False, r.stderr[:400]))
            else:
                results.append(("C++ firmware detector compiles", True, ""))
                with open(REPO / "data" / "example_session.csv") as f:
                    rc = subprocess.run([binp], stdin=f, capture_output=True, text=True)
                rp = _run([sys.executable, "sim/golden.py", "data/example_session.csv"])

                def nums(out):
                    return [[float(x.split("=")[1]) for x in ln.split()[1:]]
                            for ln in out.strip().splitlines() if ln.startswith("JUMP")]

                a, b = nums(rc.stdout), nums(rp.stdout)
                parity = (len(a) == len(b) and len(a) > 0 and all(
                    abs(x - y) <= 0.002 for ra, rb in zip(a, b) for x, y in zip(ra, rb)))
                results.append(("C++ and Python detectors agree exactly", parity,
                                f"C++ {len(a)} jumps vs Python {len(b)}"))
    else:
        results.append(("C++ parity check", True, "skipped: no g++ on this machine"))

    # 4. CLI integration tests against the fake device.
    # (JH_SKIP_CLI_TESTS guards recursion: the wizard's software check runs
    # simtest, and these tests themselves run the wizard.)
    if os.environ.get("JH_SKIP_CLI_TESTS"):
        results.append(("CLI + fake-device integration tests", True,
                        "skipped inside wizard"))
    else:
        r = _run([sys.executable, "-m", "unittest", "discover", "-s", "tools/tests"])
        results.append(("CLI + fake-device integration tests", r.returncode == 0,
                        (r.stderr or r.stdout)[-600:] if r.returncode != 0 else ""))

    print()
    all_ok = True
    for name, ok, note in results:
        mark = "✅" if ok else "❌"
        print(f"  {mark} {name}" + (f"  ({note})" if note and not ok else
                                    f"  ({note})" if note else ""))
        all_ok &= ok
    print(f"\nRESULT: {'PASS ✅ — software is good' if all_ok else 'FAIL ❌'}")
    return 0 if all_ok else 1


