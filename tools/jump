def _user_script_dirs() -> list[Path]:
    """Everywhere `pip install --user` may have put console scripts.

    Linux: ~/.local/bin. macOS system/CLT Python: ~/Library/Python/X.Y/bin —
    which is almost never on PATH, and is exactly how a successful PlatformIO
    install on a Mac once got reported as a failure."""
    dirs: list[Path] = []
    try:
        import sysconfig

        d = sysconfig.get_path("scripts", f"{os.name}_user")
        if d:
            dirs.append(Path(d))
    except (ImportError, KeyError):
        pass
    dirs.append(Path.home() / ".local" / "bin")
    dirs.extend(sorted((Path.home() / "Library" / "Python").glob("*/bin")))
    return dirs


def find_pio() -> list[str] | None:
    """The command argv that runs PlatformIO, or None if it's truly absent.

    Order: PATH; the per-OS pip --user script dirs; PlatformIO's own venv;
    finally `python -m platformio`, which works with no PATH setup at all
    whenever the package is importable by this interpreter."""
    for cand in ("pio", "platformio"):
        p = shutil.which(cand)
        if p:
            return [p]
    for d in _user_script_dirs():
        for cand in ("pio", "platformio"):
            f = d / cand
            if f.exists():
                return [str(f)]
    penv = Path.home() / ".platformio" / "penv" / "bin" / "pio"
    if penv.exists():
        return [str(penv)]
    try:
        import importlib.util

        if importlib.util.find_spec("platformio") is not None:
            return [sys.executable, "-m", "platformio"]
    except (ImportError, ValueError):
        pass
    return None


def cmd_setup(args) -> int:
    print("=== One-time toolchain setup ===\n")
    ok = True
    print(f"✅ Python {sys.version.split()[0]}")

    pio = find_pio()
    if pio:
        print(f"✅ PlatformIO already installed ({' '.join(pio)})")
    else:
        print("Installing PlatformIO (builds + uploads the firmware)...")
        r = subprocess.run([sys.executable, "-m", "pip", "install", "--user",
                            "platformio"])
        pio = find_pio()
        if r.returncode == 0 and pio:
            print(f"✅ PlatformIO installed ({' '.join(pio)})")
        else:
            print("❌ PlatformIO install failed — see https://platformio.org/install")
            ok = False

    try:
        import serial  # type: ignore  # noqa: F401
        print("✅ pyserial available")
    except ImportError:
        r = subprocess.run([sys.executable, "-m", "pip", "install", "--user",
                            "pyserial"])
        if r.returncode == 0:
            print("✅ pyserial installed")
        elif os.name == "posix":
            print("⚠️  pyserial install failed — built-in fallback will be used")
        else:
            print("❌ pyserial install failed (required on Windows)")
            ok = False

    if shutil.which("g++") or shutil.which("c++"):
        print("✅ C++ compiler (enables the firmware parity test)")
    else:
        print("⚠️  no C++ compiler — simtest will skip the parity check (fine)")

    # This tool finds pio wherever pip put it (or runs `python -m platformio`),
    # so PATH setup is optional — offer the REAL directory for convenience only.
    script_dir = next((str(d) for d in _user_script_dirs() if (d / "pio").exists()), None)
    if script_dir and script_dir not in os.environ.get("PATH", ""):
        print(f"\n(Optional) to run `pio` yourself in a terminal, add {script_dir} "
              "to your PATH.\nEvery ./tools/jump command works without that.")
    print("\nNext: ./tools/jump simtest   (should PASS with no hardware)")
    return 0 if ok else 1


def cmd_gen(args) -> int:
    import gen_params

    gen_params.HEADER_PATH.write_text(
        gen_params.render_header(gen_params.load_config(CONFIG_PATH)))
    print(f"wrote {gen_params.HEADER_PATH}")
    return 0


def cmd_flash(args) -> int:
    # Find the board BEFORE building: PlatformIO's own auto-detect happily
    # grabs macOS's phantom /dev/cu.Bluetooth-Incoming-Port and then spends
    # three minutes failing to talk to it. Our scan only counts real USB
    # serial devices, so "no board" fails here in a second, with the actual
    # fix — and when there IS exactly one board, we hand pio the explicit
    # port so its guesswork never enters the picture.
    port = args.port
    if not port:
        ports = scan_ports()
        if not ports:
            print("""No USB serial device found — the computer can't see the board.
In order of likelihood:
  1. The USB cable is charge-only. Swap cables (a lit power LED proves
     power, NOT data). Most spare micro-USB cables are charge-only.
  2. Different USB port, or plug in directly instead of through a hub.
  3. macOS + no port even with a good cable: check  > About This Mac >
     System Report > USB. If a CH340/USB-Serial device shows there but no
     /dev/cu.usbserial* exists, install the CH34x driver (older macOS
     doesn't bundle it), approve it in Privacy & Security, reboot.
If you're certain it's connected anyway: ./tools/jump flash --port <port>""")
            return 1
        if len(ports) > 1:
            print("Multiple serial devices found: " + ", ".join(ports)
                  + "\nPick the board with:  ./tools/jump flash --port <port>")
            return 1
        port = ports[0]
        print(f"Board found at {port}")
    cmd_gen(args)
    pio = find_pio()
    if not pio:
        print("PlatformIO not found — run ./tools/jump setup first.")
        return 1
    cmd = pio + ["run", "-d", str(REPO / "firmware"), "-t", "upload",
                 "--upload-port", port]
    print("Building + uploading firmware (first build downloads the toolchain — "
          "takes a few minutes once)...")
    # Stream pio's output line by line through our stdout so it lands in the
    # session log too (a plain subprocess would bypass the log tee).
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True)
    for line in proc.stdout:
        print(line, end="")
    proc.wait()
    if proc.returncode != 0:
        print("\n❌ upload failed. Board plugged in? Data-capable USB cable? "
              "Try --port <port>, and `./tools/jump report` to collect diagnostics.")
        return 1
    print("\n✅ flashed. Running self-test...")
    time.sleep(1.5)
    return cmd_selftest(args)


def cmd_monitor(args) -> int:
    port = args.port or autodetect_port()
    sp = open_serial_watchdogged(port)
    interactive = os.name == "posix"  # select() on stdin is POSIX-only
    print(f"--- monitor {port} (Ctrl-C to exit"
          + ("; type a command + Enter) ---" if interactive else "; read-only) ---"))
    try:
        while True:
            line = sp.read_line(0.1)
            if line is not None:
                print(line)
            if not interactive:
                continue
            r, _, _ = select.select([sys.stdin], [], [], 0)
            if r:
                cmdline = sys.stdin.readline()
                if cmdline:
                    sp.write_line(cmdline.strip())
    except KeyboardInterrupt:
        print("\n--- bye ---")
        return 0
    finally:
        sp.close()


def cmd_replay(args) -> int:
    # Absolutize before changing cwd, so a path relative to where the user
    # ran the command still resolves.
    cmd = [sys.executable, "sim/run.py", "--csv", os.path.abspath(args.csv)]
    if args.plot:
        cmd.append("--plot")
    return subprocess.run(cmd, cwd=str(REPO)).returncode


