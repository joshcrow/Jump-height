# ------------------------------------------------------------------- logging
# Every command tees its terminal output AND raw serial traffic (TX/RX,
# timestamped) into data/logs/<time>-<cmd>.log — so when something goes
# wrong, `./tools/jump report` can hand the whole story to a human or an AI
# assistant without the user having to reproduce anything.


class SessionLog:
    def __init__(self):
        self.path: Path | None = None
        self._f = None
        self._t0 = 0.0

    def start(self, cmd: str) -> None:
        logs = DATA_DIR / "logs"
        logs.mkdir(parents=True, exist_ok=True)
        self.path = logs / f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{cmd}.log"
        self._f = open(self.path, "w")
        self._t0 = time.monotonic()
        self._f.write(f"# jump {cmd} — {datetime.now().isoformat()}\n"
                      f"# argv: {' '.join(sys.argv[1:])}\n"
                      f"# platform: {sys.platform}  python: {sys.version.split()[0]}\n\n")
        sys.stdout = _Tee(sys.stdout, self)
        sys.stderr = _Tee(sys.stderr, self)

    def serial(self, direction: str, text: str) -> None:
        if self._f:
            self._f.write(f"[{time.monotonic() - self._t0:9.3f}] {direction} {text}\n")
            self._f.flush()

    def raw(self, text: str) -> None:
        if self._f:
            self._f.write(text)
            self._f.flush()


class _Tee:
    def __init__(self, orig, log: SessionLog):
        self._orig = orig
        self._log = log

    def write(self, s: str):
        self._orig.write(s)
        self._log.raw(s)
        return len(s)

    def flush(self):
        self._orig.flush()

    def isatty(self):
        return self._orig.isatty()


LOG = SessionLog()

# ---------------------------------------------------------------- serial I/O


class SerialPort:
    """Minimal line-oriented serial port. pyserial if available, else POSIX
    termios. Also works on a pty (the fake device)."""

    def __init__(self, path: str, baud: int = BAUD):
        self.path = path
        self._buf = b""
        self._ser = None
        self._fd = None
        try:
            import serial  # type: ignore

            # Portable path: rely on pyserial's own timeout mechanism only.
            # (No fileno()/select() here — neither works for serial handles
            # on Windows.)
            self._ser = serial.Serial(path, baud, timeout=0.25)
            # Deassert DTR/RTS so ESP32 boards settle into RUN mode — except
            # on macOS, where the WCH CH34x driver has been seen to wedge in
            # exactly this modem-control ioctl (esptool's open works; ours
            # hung — this poke was the one difference). Opening the port
            # already pulses a reset via the auto-download circuit, so
            # skipping the deassert costs nothing.
            if sys.platform != "darwin":
                try:
                    self._ser.dtr = False
                    self._ser.rts = False
                except Exception:
                    pass
        except ImportError:
            import termios
            import tty

            self._fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                tty.setraw(self._fd)
                attrs = termios.tcgetattr(self._fd)
                attrs[4] = attrs[5] = termios.B115200
                termios.tcsetattr(self._fd, termios.TCSANOW, attrs)
            except termios.error:
                pass  # pty: raw/baud not meaningful

    def write_line(self, s: str) -> None:
        LOG.serial("TX", s)
        data = (s + "\n").encode()
        if self._ser is not None:
            self._ser.write(data)
        else:
            os.write(self._fd, data)

    def read_line(self, timeout: float) -> str | None:
        """Next complete line (without newline), or None on timeout."""
        deadline = time.monotonic() + timeout
        while True:
            nl = self._buf.find(b"\n")
            if nl >= 0:
                line = self._buf[:nl].rstrip(b"\r")
                self._buf = self._buf[nl + 1:]
                decoded = line.decode(errors="replace")
                if decoded:
                    LOG.serial("RX", decoded)
                return decoded
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            wait = min(remaining, 0.25)
            chunk = b""
            if self._ser is not None:
                if self._ser.timeout != wait:
                    self._ser.timeout = wait
                try:
                    chunk = self._ser.read(1)  # blocks up to `wait`
                    if chunk and self._ser.in_waiting:
                        chunk += self._ser.read(self._ser.in_waiting)
                except OSError:
                    chunk = b""
            else:
                r, _, _ = select.select([self._fd], [], [], wait)
                if r:
                    try:
                        chunk = os.read(self._fd, 4096)
                    except (OSError, BlockingIOError):
                        chunk = b""
            if chunk:
                self._buf += chunk

    def close(self) -> None:
        # Idempotent on purpose: the untethered flows close a device to let
        # the human unplug it, reconnect as a new object, and an outer
        # finally may close the stale handle again.
        if self._ser is not None:
            self._ser.close()
            self._ser = None
        elif self._fd is not None:
            os.close(self._fd)
            self._fd = None


KNOWN_USB_GLOBS = [
    "/dev/ttyUSB*", "/dev/ttyACM*",
    # macOS: always the cu.* device, never tty.* (tty blocks on carrier-detect)
    "/dev/cu.usbserial*", "/dev/cu.wchusbserial*", "/dev/cu.SLAB*",
    "/dev/cu.usbmodem*",
]


def scan_ports() -> list[str]:
    candidates: list[str] = []
    try:
        from serial.tools import list_ports  # type: ignore

        candidates = [p.device for p in list_ports.comports() if p.vid is not None]
        # On macOS pyserial reports both /dev/cu.* and /dev/tty.* — keep cu only.
        candidates = [c for c in candidates if not c.startswith("/dev/tty.")]
    except ImportError:
        for g in KNOWN_USB_GLOBS:
            candidates.extend(glob.glob(g))
    return sorted(set(candidates))


def autodetect_port() -> str:
    candidates = scan_ports()
    if len(candidates) == 1:
        return candidates[0]
    if not candidates:
        raise SystemExit(
            "No USB serial device found. Plug the FireBeetle in (data USB cable, "
            "not charge-only), or pass --port /dev/ttyUSB0")
    raise SystemExit(
        f"Multiple serial devices found: {', '.join(candidates)} — pick one with --port")


def parse_kv(line: str) -> dict:
    """'JUMP n=1 airtime_s=0.62' -> {'_tag': 'JUMP', 'n': '1', 'airtime_s': '0.62'}.
    Bare (non key=value) words land in '_args': 'STATE recording' ->
    {'_tag': 'STATE', '_args': ['recording']}."""
    parts = line.split()
    out: dict = {"_tag": parts[0] if parts else "", "_args": []}
    for p in parts[1:]:
        if "=" in p:
            k, v = p.split("=", 1)
            out[k] = v
        else:
            out["_args"].append(p)
    return out


def _last_tagged(lines: list[str], prefix: str) -> dict:
    """parse_kv() of the LAST line starting with `prefix` (PARAMS/CAL/INFO
    lines only ever repeat with updated values), or {} if none appear."""
    kv: dict = {}
    for line in lines:
        if line.startswith(prefix):
            kv = parse_kv(line)
    return kv


# ------------------------------------------------------------- device session


def open_serial_watchdogged(port: str, timeout_s: float = 8.0) -> SerialPort:
    """Open the port, but never hang doing it.

    Field find: on macOS the WCH CH34x driver can block the open() call
    indefinitely when the port is reopened right after an esptool session —
    a real builder watched "Connecting..." for three minutes. Nothing in this
    tool is allowed to hang silently: open in a worker thread and give up
    loudly after a few seconds with the actual remedy (replug the board).
    If the stray open ever completes later, the daemon thread just closes it.
    """
    import threading

    result: dict = {}

    def _worker():
        try:
            result["sp"] = SerialPort(port)
        except Exception as e:  # surfaced below on the main thread
            result["err"] = e
        if "sp" in result and result.get("abandoned"):
            try: result["sp"].close()
            except Exception: pass

    t = threading.Thread(target=_worker, daemon=True)
    t.start()
    t.join(timeout_s)
    if t.is_alive():
        result["abandoned"] = True
        raise TimeoutError(
            f"opening {port} is stuck (a known macOS WCH-driver quirk right "
            "after flashing). Unplug the board, plug it back in, and retry.")
    if "err" in result:
        raise result["err"]
    return result["sp"]


class Device:
    """A connected (real or fake) device speaking the firmware protocol."""

    def __init__(self, port: str):
        self.sp = open_serial_watchdogged(port)
        self.boot_lines: list[str] = []

    def drain_boot(self, timeout: float = 5.0) -> None:
        """Board resets when the port opens; swallow the boot banner/POST.

        Special case: the firmware's first boot ever formats its storage
        partition and announces it, then goes silent for up to a minute.
        Seeing that announcement extends our patience so the one-time format
        doesn't read as a dead device."""
        deadline = time.monotonic() + timeout
        saw_any = False
        formatting = False
        while time.monotonic() < deadline:
            line = self.sp.read_line(2.5 if formatting else 0.6)
            if line is None:
                if saw_any and not formatting:
                    break  # went quiet after output: boot finished
                continue
            saw_any = True
            self.boot_lines.append(line)
            if "formatting storage" in line:
                formatting = True
                deadline = max(deadline, time.monotonic() + 90.0)
                print("    (first boot: the device is formatting its storage — "
                      "up to a minute, one time only)")
            if "storage ready" in line or "storage format failed" in line:
                formatting = False
            if line.strip() == "READY":
                break

    def drain_pending(self) -> list[str]:
        """Read whatever's already buffered, returning quickly once it's dry.

        Guided steps use this to learn what the device did BETWEEN steps —
        e.g. a STATE flip that fired while the human was reading a prompt —
        instead of letting stale lines confuse (or satisfy) the next wait_for.
        """
        lines: list[str] = []
        while True:
            line = self.sp.read_line(0.15)
            if line is None:
                return lines
            lines.append(line)

    def command(self, cmd: str, timeout: float = 20.0) -> list[str]:
        """Send a command, return all lines up to its OK/ERR terminator.

        `timeout` is an INACTIVITY timeout: it resets every time a line
        arrives, so a long-but-flowing transfer (e.g. a full `dump` at
        115200 baud) never trips it, while a genuinely stuck device does.
        """
        self.sp.write_line(cmd)
        lines: list[str] = []
        while True:
            line = self.sp.read_line(timeout)
            if line is None:
                raise TimeoutError(
                    f"device went silent during '{cmd}' — is the right firmware flashed?")
            if line.strip() == f"OK {cmd.split()[0]}":
                return lines
            if line.startswith("ERR"):
                lines.append(line)
                return lines
            lines.append(line)

    def wait_for(self, tag: str, timeout: float, echo_chatter: bool = True,
                 value: str | None = None) -> dict | None:
        """Wait for the next machine line with the given tag (e.g. 'JUMP').

        With `value`, only a line whose first bare word matches counts —
        e.g. wait_for('STATE', 30, value='recording') will not be satisfied
        by 'STATE idle'.
        """
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            line = self.sp.read_line(deadline - time.monotonic())
            if line is None:
                return None
            if line.startswith(tag + " ") or line.strip() == tag:
                kv = parse_kv(line)
                if value is None or (kv["_args"] and kv["_args"][0] == value):
                    return kv
                continue  # right tag, wrong value (e.g. STATE idle): keep waiting
            if echo_chatter and line.startswith("#"):
                print(f"    {line}")
        return None

    def close(self) -> None:
        self.sp.close()


def spawn_fake(scenario: str, fast: bool, extra: list[str] | None = None):
    cmd = [sys.executable, str(REPO / "tools" / "fake_device.py"),
           "--scenario", scenario]
    if fast:
        cmd.append("--fast")
    cmd += extra or []
    env = dict(os.environ)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, env=env)
    first = proc.stdout.readline().strip()
    if not first.startswith("PTY "):
        proc.terminate()
        raise SystemExit(f"fake device failed to start: {first!r}")
    return proc, first.split(None, 1)[1]


def open_device(args, fake_scenario: str = "ok", fake_extra: list[str] | None = None):
    """Returns (Device, fake_proc_or_None)."""
    if getattr(args, "fake", False):
        proc, port = spawn_fake(fake_scenario, getattr(args, "fast", False), fake_extra)
        dev = Device(port)
        dev.drain_boot(timeout=3.0)
        return dev, proc
    port = args.port or None
    # A remembered port name (wizard state, --port) can go stale: macOS
    # assigns a different suffix per USB socket/hub, so the same board can be
    # ...1440 today and ...1430 tomorrow. Never trust a name that isn't
    # currently present — re-scan instead of crashing into pyserial.
    if port and port not in scan_ports():
        print(f"(saved port {port} is gone — Macs shuffle these names; re-scanning)")
        port = None
    if not port:
        port = autodetect_port()
    print(f"Connecting to {port} (the board resets when the port opens — normal)...")
    try:
        dev = Device(port)
    except OSError as e:  # pyserial's SerialException is an OSError too
        print(f"❌ couldn't open {port}: {e}")
        print("   Unplug/replug the USB cable, then re-run — wizards resume where")
        print("   they left off. Still stuck? ./tools/jump report → send to Claude.")
        raise SystemExit(1)
    dev.drain_boot()
    return dev, None


def _close_device(dev: "Device | None", proc) -> None:
    """Shared `finally:` cleanup for an open_device() (Device, fake_proc) pair."""
    if dev:
        dev.close()
    if proc:
        proc.terminate()


# ----------------------------------------------------------------- self-test

MARKS = {"PASS": "✅", "WARN": "⚠️ ", "FAIL": "❌", "SKIP": "—"}


def render_selftest(lines: list[str]) -> bool:
    """Pretty-print SELFTEST lines + hints. Returns True if result=PASS."""
    ok = False
    for line in lines:
        if line.startswith("SELFTEST END"):
            ok = "result=PASS" in line
        elif line.startswith("SELFTEST BEGIN"):
            continue
        elif line.startswith("SELFTEST "):
            _, name, status, *rest = line.split()
            detail = rest[0].replace("detail=", "") if rest else ""
            print(f"  {MARKS.get(status, '?')} {name:<8} {detail}")
        elif line.startswith("# hint:"):
            print(f"       {line.replace('# hint:', 'hint:')}")
    return ok


def _print_config_diffs(kind: str, diffs: list[str]) -> None:
    """check_device_params' two mismatch warnings share this shape: a '<kind>
    from config/params.json — run flash' header + one indented line/diff."""
    print(f"  ⚠️  {kind} from config/params.json — run ./tools/jump flash:")
    for d in diffs:
        print(f"       {d}")


def check_device_params(dev: Device) -> bool:
    """Compare the flashed firmware's params against local config/params.json."""
    try:
        lines = dev.command("info", timeout=8)
    except TimeoutError:
        print("  (couldn't read device info — old firmware? run ./tools/jump flash)")
        return False
    from detector import load_params

    local = load_params(CONFIG_PATH)
    device_kv = {k: v for k, v in _last_tagged(lines, "PARAMS ").items() if k != "_tag"}
    cal_kv = {k: v for k, v in _last_tagged(lines, "CAL ").items() if k != "_tag"}
    info_kv = {k: v for k, v in _last_tagged(lines, "INFO ").items() if k != "_tag"}
    if not device_kv:
        print("  (device didn't report its params — old firmware? run ./tools/jump flash)")
        return False
    # The two calibration terms may legitimately live on the DEVICE (set over
    # BLE/serial, persisted in NVS) — judge them from the CAL line, not from
    # the compiled PARAMS summary.
    CAL_KEYS = ("airtime_offset_s", "height_scale")
    mismatches = []
    for key, dev_val in device_kv.items():
        if key in CAL_KEYS and cal_kv:
            continue
        local_val = getattr(local, key, None)
        if local_val is None:
            continue
        try:
            if not math.isclose(float(dev_val), float(local_val),
                                rel_tol=1e-4, abs_tol=1e-6):
                mismatches.append(f"{key}: device={dev_val} local={local_val:g}")
        except ValueError:
            pass
    # The firmware section (sampling rates, motion gate) is compiled in too —
    # compare what the INFO line reports so a config tweak without a reflash
    # can't masquerade as applied.
    if info_kv:
        try:
            with open(CONFIG_PATH) as f:
                fw_local = json.load(f).get("firmware", {})
        except (OSError, ValueError):
            fw_local = {}
        for key in ("sample_hz", "log_hz", "motion_thresh_g", "idle_timeout_s"):
            if key in info_kv and key in fw_local:
                try:
                    if not math.isclose(float(info_kv[key]), float(fw_local[key]),
                                        rel_tol=1e-4, abs_tol=1e-6):
                        mismatches.append(f"{key}: device={info_kv[key]} "
                                          f"local={fw_local[key]:g}")
                except ValueError:
                    pass
    if mismatches:
        _print_config_diffs("device settings differ", mismatches)
        return False
    if cal_kv:
        cal_diffs = []
        for key in CAL_KEYS:
            try:
                if not math.isclose(float(cal_kv.get(key, "nan")),
                                    float(getattr(local, key)),
                                    rel_tol=1e-4, abs_tol=1e-6):
                    cal_diffs.append(f"{key}: device={cal_kv[key]} "
                                     f"config={getattr(local, key):g}")
            except ValueError:
                pass
        if cal_diffs and cal_kv.get("source") == "device":
            print("  ℹ️  device carries its own calibration (saved over the wire) —")
            print("     the device wins; config/params.json is just the bench record:")
            for d in cal_diffs:
                print(f"       {d}")
        elif cal_diffs:
            _print_config_diffs("calibration differs", cal_diffs)
            return False
    print("  ✅ device settings match config/params.json")
    return True


def cmd_selftest(args) -> int:
    dev, proc = open_device(args, "badwiring" if getattr(args, "fake_fail", False) else "ok")
    try:
        lines = dev.command("selftest", timeout=15)
        print("Self-test:")
        ok = render_selftest(lines)
        params_ok = check_device_params(dev)
        if ok:
            print("\nRESULT: PASS ✅ — hardware is good."
                  + ("" if params_ok else " (but re-flash to sync settings)"))
            return 0
        print("\nRESULT: FAIL ❌ — follow the hints above, fix the wiring, and run "
              "./tools/jump selftest again. No re-flash needed.")
        return 1
    finally:
        _close_device(dev, proc)


# ------------------------------------------------------------------ desktest


def _pause(args, dev: Device, msg: str) -> None:
    if getattr(args, "fake", False):
        print(f">> {msg}")
        dev.sp.write_line("_sim next")  # tell the fake "the human just did this"
    elif not sys.stdin.isatty():
        print(f">> {msg}")
    else:
        input(f">> {msg}  [Enter when ready] ")


def _autopsy_trace(dev: "Device") -> None:
    """After a failed desk test, read the device's own 50 Hz recording back
    and explain every flight it saw — the sensor witnessed everything, so a
    failure should end in a diagnosis, not a shrug. Best-effort by design."""
    try:
        from detector import load_params
        p = load_params(CONFIG_PATH)
        print("\n  Reading the device's own recording of what just happened...")
        # The stored trace grows until `clear` — after a bench week it can be
        # megabytes, and USB serial moves ~11.5 KB/s. Without progress output
        # a big download reads as a hang (a real user watched exactly that).
        tb = 0
        try:
            for ln in dev.command("stats", timeout=8):
                if ln.startswith("STATS"):
                    tb = int(parse_kv(ln).get("trace_bytes", "0"))
        except Exception:
            pass
        if tb > 60000:
            print(f"  ({tb // 1024} KB of recording stored — roughly "
                  f"{max(1, tb // 11520)}s over USB. Tip: after a PASSED desk "
                  "test, `clear` keeps this fast.)")
        rows: list[tuple[float, float]] = []
        in_file = False
        got = 0
        next_mark = 51200
        dev.sp.write_line("trace")
        while True:
            ln = dev.sp.read_line(30.0)
            if ln is None or ln.strip() == "OK trace" or ln.startswith("ERR"):
                break
            got += len(ln) + 1
            if got >= next_mark:
                # Clamp at 100%: `got` counts every received line including
                # the "FILE trace.csv BEGIN/END" framing, which isn't part
                # of `tb` (STATS' trace_bytes, the stored CSV content only)
                # — so the raw ratio can otherwise tick past 100%.
                pct = f"  {min(100, 100 * got // tb)}%" if tb else ""
                print(f"    … {got // 1024} KB{pct}", flush=True)
                next_mark += 51200
            if ln.startswith("FILE trace.csv BEGIN"):
                in_file = True
            elif ln.startswith("FILE trace.csv END"):
                in_file = False
            elif in_file and "," in ln and not ln.startswith(("t,", "#")):
                try:
                    ts, ms = ln.split(",", 1)
                    rows.append((float(ts), float(ms)))
                except ValueError:
                    pass
        if len(rows) < 20:
            print("  (not enough recorded data to analyze)")
            return
        out = DATA_DIR / "diagnostics" / f"desktest-trace-{datetime.now():%Y%m%d-%H%M%S}.csv"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text("t,mag\n" + "\n".join(f"{t:.3f},{m:.3f}" for t, m in rows) + "\n")

        # Find free-fall dips at the trace's rate, then the landing peak after
        # each. Slightly looser than the live detector on purpose: the 50 Hz
        # log undersamples a 10-30 ms landing spike, so we report the peak we
        # can SEE and judge against the threshold with honest wording.
        flights = []  # (t_start, dip_dur, landing_peak, airtime_to_peak)
        # The stored trace stitches every power-on together and time restarts
        # at each boot — analyze per segment, or a dip right before a reboot
        # "lands" in the next boot's timeline and reports negative airtime
        # (a real autopsy printed '-55.86s of air' exactly this way).
        segments = split_segments(rows)
        if len(segments) > 1:
            print(f"  (recording spans {len(segments)} power-ons; "
                  "times restart at each)")
        for seg in segments:
            i = 0
            while i < len(seg):
                if seg[i][1] < p.freefall_enter_g:
                    j = i
                    while j < len(seg) and seg[j][1] < p.freefall_enter_g:
                        j += 1
                    dur = seg[j - 1][0] - seg[i][0]
                    if dur >= max(0.06, p.freefall_confirm_s - 0.02):
                        peak, peak_t = 0.0, None
                        k = j
                        while k < len(seg) and seg[k][0] - seg[j - 1][0] <= 0.4:
                            if seg[k][1] > peak:
                                peak, peak_t = seg[k][1], seg[k][0]
                            k += 1
                        air = (peak_t - seg[i][0]) if peak_t is not None else None
                        flights.append((seg[i][0], dur, peak, air))
                    i = j
                else:
                    i += 1

        if not flights:
            print("  Autopsy: the recording shows NO free-fall at all. The usual")
            print("  culprit is SPIN — a tumbling box feels its own rotation and")
            print("  never reads weightless. Toss it dead flat, no wrist flick,")
            print("  straight up. (Also: is the sensor foamed near the box center?)")
            print(f"  (recording saved: {out} — send it to Claude if stuck)")
            return
        print(f"  Autopsy — the device saw {len(flights)} flight(s):")
        for t0, dur, peak, air in flights[-6:]:
            if air is not None and air >= p.min_airtime_s and peak > p.landing_threshold_g:
                print(f"    t={t0:6.1f}s  ✅ valid-looking jump: {air:.2f}s air, "
                      f"{peak:.1f}g landing (this one should have counted)")
            elif air is not None and air < p.min_airtime_s:
                print(f"    t={t0:6.1f}s  too SHORT: ~{air:.2f}s of air "
                      f"(needs ≥ {p.min_airtime_s:.2f}s) → toss higher")
            else:
                print(f"    t={t0:6.1f}s  soft LANDING: free-fall {dur:.2f}s but the "
                      f"landing peaked at only {peak:.1f}g")
                print(f"              (the detector needs > {p.landing_threshold_g:.1f}g)"
                      " → land it on something firmer")
        print(f"  (recording saved: {out} — send it to Claude if this looks wrong)")
    except Exception as e:  # diagnosis must never crash the wizard itself
        print(f"  (autopsy unavailable: {e})")


def _wait_for_port_return(prev_port: str | None, baseline: set[str],
                          timeout: float = 90.0) -> str | None:
    """Wait for OUR board's port to reappear after a replug.

    `baseline` is the port set captured while the board was still plugged in:
    only the previous port name (macOS reuses it) or a port NOT in the
    baseline qualifies — a second adapter that was already present can never
    be grabbed by mistake.
    """
    print("  Watching for the board on USB", end="", flush=True)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        ports = scan_ports()
        pick = None
        if prev_port and prev_port in ports:
            pick = prev_port
        else:
            fresh = [p for p in ports if p not in baseline]
            if fresh:
                pick = fresh[0]
        if pick:
            print(f" — found {pick}")
            time.sleep(1.5)  # give the OS a beat to finish creating the node
            return pick
        print(".", end="", flush=True)
        time.sleep(1.0)
    print(" nothing.")
    return None


def _replug_pause() -> None:
    """Block until the human confirms the cable is back — TTY-safe."""
    if sys.stdin.isatty():
        input("\n>> Press Enter AFTER the cable is back in... ")
    else:
        print("\n>> (non-interactive: continuing)")


def _reopen_after_replug(dev: "Device") -> "Device | None":
    """Close `dev`, wait through the human's unplug/replug, and reopen it on
    whatever port returns — shared by both untethered flows. None if it
    never came back (the caller reports and bails)."""
    prev_port, baseline = dev.sp.path, set(scan_ports())
    dev.close()
    _replug_pause()
    port = _wait_for_port_return(prev_port, baseline)
    if port is None:
        print("❌ The board never came back on USB. Check the cable, re-run.")
        return None
    return Device(port)


def _parse_jump_row(parts: list[str]) -> dict | None:
    """One data row of the jumps.csv format — shared by the device's live
    `jumps`/`dump` output and a synced session file on disk, since both are
    exactly 'n,takeoff_s,airtime_raw_s,airtime_s,height_m'. `adj` is the
    airtime AFTER whatever airtime_offset_s was active when it was recorded."""
    if len(parts) < 5:
        return None
    try:
        return {"n": int(parts[0]), "raw": float(parts[2]),
                "adj": float(parts[3]), "h": float(parts[4])}
    except ValueError:
        return None


def _stored_rows(dev: "Device") -> list[dict]:
    """The device's jumps.csv, parsed: [{'n':…, 'raw':…, 'adj':…, 'h':…}, …]."""
    rows: list[dict] = []
    in_f = False
    for ln in dev.command("jumps", timeout=20):
        if ln.startswith("FILE jumps.csv BEGIN"):
            in_f = True
        elif ln.startswith("FILE jumps.csv END"):
            break
        elif in_f and "," in ln and not ln.startswith(("n,", "#")):
            row = _parse_jump_row(ln.split(","))
            if row:
                rows.append(row)
    return rows


def _is_plausible_toss(raw_s: float) -> bool:
    """Airtime range a gentle hand toss over a cushion should land in —
    shared by the untethered and --fake desk test flows."""
    return 0.10 <= raw_s <= 1.2


def _desktest_untethered(dev: "Device") -> int:
    """Toss test for a real board: NO cable during the tosses.

    Yanked USB plugs killed more desk tests than physics did. The device is
    a logger — so test it the way it's actually used: baseline the stored
    jump list, unplug, toss free, replug, and read back what it recorded
    entirely on its own.
    """
    print("\n[2/3] Baseline...")
    base_n = len(_stored_rows(dev))
    print(f"  {base_n} jump(s) already in storage (they won't count).")
    print("\n[3/3] Untethered tosses — no cable involved:")
    print("  1. Unplug the USB cable (the battery keeps the board running).")
    print("  2. Give it a wake-up shake.")
    print("  3. THREE tosses over the cushion: a foot or more straight up,")
    print("     flat like a pizza tray — let it LAND, don't catch it.")
    print("  4. Plug the cable back in and return here.")
    dev2 = _reopen_after_replug(dev)
    if dev2 is None:
        return 1
    try:
        dev2.drain_boot(timeout=3.0)
        new = _stored_rows(dev2)[base_n:]
        good = 0
        for k, r in enumerate(new, 1):
            ok = _is_plausible_toss(r["raw"])
            mark = "✅" if ok else "⚠️"
            note = "" if ok else "  (implausible for a hand toss — ignored)"
            print(f"  {mark} flight {k}: airtime {r['raw']:.2f}s → "
                  f"height {r['h']:.2f} m{note}")
            good += 1 if ok else 0
        if good >= 3:
            print(f"\nRESULT: PASS ✅ — assembly verified: {good} clean tosses,")
            print("recorded entirely on its own, no cable.")
            print("\nThat just proved the three things a water session needs:")
            print("  • it runs on the battery alone")
            print("  • the detector fires on real motion")
            print("  • jumps SURVIVE to storage (the self-test only proves the")
            print("    filesystem mounts, not that a jump is ever written)")
            print("\nBefore the water:")
            print("  • Pair the WATCH ONLY — no Mac/phone connected at the same")
            print("    time. A second BLE central corrupts the watch display")
            print("    (open bug, garmin/FIRST_COMPILE.md), and watch-only is")
            print("    also the control run that investigation still needs.")
            print("  • `off` does NOT wake from steady USB power — it needs a")
            print("    plug-in edge or the reset button. Don't power down at the")
            print("    beach unless you can reach one (SENSE_FIRST_BOOT 16j).")
            print("  • Top the battery up; check `stats` for batt_pct first.")
            print("\nNext: ./tools/jump drop  (skip if this unit is already")
            print("calibrated — check `info` for CAL source=device)")
            return 0
        if not new:
            print("  No new flights in storage at all.")
        print(f"\nRESULT: CHECK ⚠️ — {good} plausible toss(es) in storage; need 3.")
        _autopsy_trace(dev2)
        print("\n     Adjust per the autopsy, then re-run — the wizard resumes here.")
        print("     Stuck? ./tools/jump report → send the file to Claude.")
        return 1
    finally:
        dev2.close()


def cmd_desktest(args) -> int:
    dev, proc = open_device(args, "desktest")
    try:
        print("=== Desk test: proves the whole assembly works ===\n")
        print("[1/3] Self-test...")
        ok = render_selftest(dev.command("selftest", timeout=15))
        if not ok:
            print("\nFix the wiring per the hints above, then re-run. Stopping here.")
            return 1

        # Real hardware runs the untethered flow (unplug → toss → replug →
        # read storage back); the scripted live flow below stays for --fake,
        # which can't be unplugged.
        if not getattr(args, "fake", False):
            return _desktest_untethered(dev)

        print("\n[2/3] Motion gate...")
        # A real board is often ALREADY recording at this point: the human
        # just wired/flashed/moved it, and the gate stays active until 20
        # still seconds pass — so a shake produces NO new "STATE recording"
        # transition. (The fake device is scripted to be idle here, which is
        # why rehearsals never caught this.) Be state-agnostic: learn the
        # current state from the backlog, settle to idle if needed, and start
        # listening BEFORE asking the human to move anything.
        state = None
        for line in dev.drain_pending():
            kv = parse_kv(line)
            if kv["_tag"] == "STATE" and kv["_args"]:
                state = kv["_args"][0]
        if state == "recording":
            print("  It's already recording — it felt you handling it just now.")
            print("  Set it on the table and take your hands off (~20 s)...")
            if dev.wait_for("STATE", timeout=45, value="idle") is None:
                print("❌ Never settled to idle. Wobbly table? Re-run when calm.")
                return 1
            print("  ✅ idle — now the wake-up:")
        _pause(args, dev, "Press Enter, THEN pick it up and shake it.")
        kv = dev.wait_for("STATE", timeout=(30 if state else 12), value="recording")
        if kv is None and state is None:
            # Unknown starting state and no transition: it was almost
            # certainly recording all along. Settle it, then one retry.
            print("  No transition seen — it was probably recording already.")
            print("  Set it down and take your hands off (~20 s)...")
            if dev.wait_for("STATE", timeout=45, value="idle") is not None:
                _pause(args, dev, "It's idle. Press Enter, THEN shake it.")
                kv = dev.wait_for("STATE", timeout=30, value="recording")
        if kv is None:
            print("❌ Never saw motion. Is it wired and self-testing OK? Try again.")
            return 1
        print("  ✅ motion detected — recording")

        print("\n[3/3] Jump detection: 3 gentle tosses.")
        print("  Toss the device ~30–50 cm straight up over a cushion or bed and")
        print("  let it land. (Drops under ~35 cm are ignored by design.)\n")
        heights = []
        for i in range(1, 4):
            # A quiet toss (too low, or a landing too plush to spike) should
            # cost one retry, not the whole run — a real field lesson.
            ev = None
            for attempt in range(1, 4):
                label = f"Toss {i} of 3" + (f", attempt {attempt}" if attempt > 1 else "")
                _pause(args, dev, f"{label} — press Enter, then toss.")
                ev = dev.wait_for("JUMP", timeout=30)
                if ev is not None:
                    break
                print("  … nothing detected on that one. Usual causes:")
                print("    • spin — a tumbling box never reads weightless: toss it FLAT,")
                print("      no wrist flick (watch for '# almost a jump' hints above)")
                print("    • toss too low — it needs ~a foot of rise (airtime ≥ 0.25 s)")
                print("    • landing too soft — very plush bedding swallows the 'thud';")
                print("      a firmer cushion or a folded towel on the table works better")
            if ev is None:
                print(f"  ❌ toss {i}: three quiet tosses in a row.")
                _autopsy_trace(dev)
                print("\n     Adjust per the autopsy above, then re-run — the wizard")
                print("     resumes here. Stuck? ./tools/jump report → send to Claude.")
                return 1
            raw = float(ev.get("airtime_raw_s", 0))
            h = float(ev.get("height_m", 0))
            plaus = "✅" if _is_plausible_toss(raw) else "⚠️ implausible for a hand toss"
            print(f"  {plaus} toss {i}: airtime {raw:.2f}s → height {h:.2f} m")
            heights.append(h)

        stats_lines = dev.command("stats", timeout=8)
        n = 0
        for line in stats_lines:
            if line.startswith("STATS"):
                n = int(parse_kv(line).get("session_jumps", "0"))
        if n >= 3 and len(heights) == 3:
            print(f"\nRESULT: PASS ✅ — assembly verified ({n} jumps this session).")
            print("Next: calibration with ./tools/jump drop")
            return 0
        print(f"\nRESULT: CHECK ⚠️ — expected 3 recorded jumps, device says {n}.")
        return 1
    finally:
        _close_device(dev, proc)


