<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  packaging/com.jumpheight.rideloop.plist - LaunchAgent TEMPLATE for
  tools/ride_loop.py, the ride watcher that runs on the OWNER's Mac (this
  machine), not Nick's - the counterpart to com.jumpheight.puckd.plist,
  which is Nick's.

  This is a TEMPLATE, not the installed file. __PYTHON__ and __SCRIPT__ are
  placeholders that `python3 tools/ride_loop.py -install` fills in with
  sys.executable and this checkout's own absolute path to tools/ride_loop.py
  (ride_loop.render_plist()), then writes the RESULT to
  ~/Library/LaunchAgents/com.jumpheight.rideloop.plist and loads it with
  `launchctl bootstrap gui/$UID` - CLAUDE.md §4: one template, filled in at
  install time, rather than two independently hand-maintained plists (one
  here, one on disk) that can drift apart. Never run -install from an
  automated session; the owner runs it by hand.

  One long-lived process, not StartInterval (changed 2026-10-08). The script
  keeps its own ten-minute schedule (the every flag set to 600 below,
  ride_loop.run_every()),
  launchd only keeps it alive. MEASURED on this Mac, macOS 27.0: the old
  StartInterval job stopped being started after 2026-10-05 23:07 and
  launchctl print showed "pended nondemand spawn = interval" for 48 hours;
  its load-time spawn was then pended too ("speculative"), even as a
  Standard job. A demand spawn (launchctl kickstart) always ran it, which is
  why install() kickstarts after bootstrap. Why launchd pends these spawns
  is not established.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jumpheight.rideloop</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SCRIPT__</string>
        <string>--every</string>
        <string>600</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RIDE_LOOP_RCLONE</key>
        <string>/opt/homebrew/bin/rclone</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUTF8</key><string>1</string>
        <key>LANG</key><string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!--
      KeepAlive: the process is meant to run forever, so any exit is worth a
      restart. If launchd pends that restart the way it pended the interval,
      install() or a manual kickstart is the way back; the daemon.log of a
      watcher that stopped shows its last cycle line.
    -->
    <key>KeepAlive</key>
    <true/>

    <!--
      Standard, not Background (changed 2026-10-08). MEASURED on the owner's
      Mac, macOS 27.0, on AC power with Low Power Mode off: after 612 runs the
      job stopped being started on 2026-10-05 23:07, and launchctl print showed
      "pended nondemand spawn = interval" for 48 hours, with no leftover
      process holding its coalition. A manual kickstart ran it cleanly; the
      next interval spawn was pended again. macOS defers Background-class
      interval jobs at its own discretion, and for a watcher whose whole point
      is that a ride shows up within ten minutes, that deferral was silent and
      indefinite. The job is light: one rclone listing per run.
    -->
    <key>ProcessType</key>
    <string>Standard</string>

    <key>StandardOutPath</key>
    <string>/tmp/com.jumpheight.rideloop.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.jumpheight.rideloop.err.log</string>
</dict>
</plist>
