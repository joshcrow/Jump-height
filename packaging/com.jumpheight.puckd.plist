<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  packaging/com.jumpheight.puckd.plist — LaunchAgent template.

  packaging/install.sh copies this into ~/Library/LaunchAgents/ (expanding
  no placeholders — /Applications/JumpHeight Sync.app is a fixed path) and
  loads it with `launchctl bootstrap gui/$UID`. RunAtLoad + KeepAlive means
  the menu-bar app comes back on login and after any crash, matching
  docs/sync-agent-plan.md's Layout line: "the loop + state machine ... ;
  LaunchAgent at ~/Library/LaunchAgents/com.jumpheight.puckd.plist".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jumpheight.puckd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/JumpHeight Sync.app/Contents/MacOS/JumpHeight Sync</string>
        <!--
          REQUIRED. Without it the launchd-started copy runs
          packaging/src/launcher.py's self-install again: it boots ITSELF
          out, bootstraps a fresh copy, which does the same, forever, with
          KeepAlive putting it back every time. launcher.py writes this
          argument itself (LAUNCHD_FLAG); this hand-written template is the
          one place it could go missing.
        -->
        <string>--launchd</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUTF8</key><string>1</string>
        <key>LANG</key><string>en_US.UTF-8</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/com.jumpheight.puckd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.jumpheight.puckd.err.log</string>
</dict>
</plist>
